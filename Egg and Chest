-- Teleport function using smooth movement
local root = player.Character:WaitForChild("HumanoidRootPart")

local function stepTo(targetCFrame, stepSize, delayTime)
    local current = root.CFrame
    local distance = (targetCFrame.Position - current.Position).Magnitude
    local steps = math.floor(distance / stepSize)

    for i = 1, steps do
        local progress = i / steps
        local newPosition = current.Position:Lerp(targetCFrame.Position, progress)
        local newCFrame = CFrame.new(newPosition) * (targetCFrame - targetCFrame.Position)
        root.CFrame = newCFrame
        task.wait(delayTime)
    end

    root.CFrame = targetCFrame -- snap to final position
end

-- Function to send data to Discord (unchanged)
local function sendToDiscord(username, itemName, percentage)
    local webhookURL = webhookInputBox.Text
    if webhookURL == "" then
        webhookURL = " "
    end

    local data = {
        ["content"] = "<@595483398882066434> " .. username .. " just hatched " .. itemName .. percentage
    }

    local jsonData = HttpService:JSONEncode(data)

    pcall(function()
        HttpService:PostAsync(webhookURL, jsonData, Enum.HttpContentType.ApplicationJson)
    end)
end

local function refreshEggsAndChests()
    -- Clear existing items
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("TextLabel") or child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local rendered = workspace:FindFirstChild("Rendered")
    local riftsFolder = rendered and rendered:FindFirstChild("Rifts")
    if not riftsFolder then return end

    -- Store eggs and chests in a table to sort them by Y-level
    local items = {}

    -- Collect all eggs and chests
    for _, item in ipairs(riftsFolder:GetChildren()) do
        if item:IsA("Model") and (item.Name:match("%-egg$") or item.Name:match("golden%-chest") or item.Name:match("royal%-chest")) then
            local luckText = "N/A"
            local timerText = "N/A"
            local display = item:FindFirstChild("Display")
            if display then
                local gui = display:FindFirstChild("SurfaceGui")
                local icon = gui and gui:FindFirstChild("Icon")
                local luck = icon and icon:FindFirstChild("Luck")
                local timer = gui and gui:FindFirstChild("Timer")
                if luck and luck:IsA("TextLabel") then
                    luckText = luck.Text
                end
                if timer and timer:IsA("TextLabel") then
                    timerText = timer.Text
                end
            end

            -- Get the Y level of the item
            local yValue = 0
            if typeof(item.GetPivot) == "function" then
                yValue = item:GetPivot().Position.Y
            elseif item.PrimaryPart then
                yValue = item.PrimaryPart.Position.Y
            end

            table.insert(items, { item = item, luckText = luckText, timerText = timerText, yValue = yValue })
        end
    end

    -- Sort items by their Y-level (ascending order)
    table.sort(items, function(a, b)
        return a.yValue < b.yValue
    end)

    -- Create UI for each item
    for _, data in ipairs(items) do
        local item = data.item
        local luckText = data.luckText
        local timerText = data.timerText

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -10, 0, 25)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.Font = "SourceSans"
        label.TextSize = 18
        label.TextXAlignment = "Left"
        label.Text = string.format("%s | Luck: %s | Y: %.1f | Timer: %s", item.Name, luckText, data.yValue, timerText)
        label.Parent = scrollFrame

        -- Create teleport button below the item
        local teleportButton = Instance.new("TextButton")
        teleportButton.Size = UDim2.new(0, 100, 0, 30)  -- Adjust size for each item
        teleportButton.Text = "🔮 Teleport"
        teleportButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        teleportButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        teleportButton.Font = "SourceSans"
        teleportButton.TextSize = 16
        teleportButton.Position = UDim2.new(1, -110, 0, 25) -- Position below the label
        teleportButton.Parent = scrollFrame

        -- Teleport action when the button is clicked
        teleportButton.MouseButton1Click:Connect(function()
            local cframeToTeleport = item.PrimaryPart and item.PrimaryPart.CFrame or item:GetPivot()
            if cframeToTeleport then
                stepTo(cframeToTeleport, 25, 0.025) -- Use the stepTo function for smooth teleportation
            end
        end)
    end

    -- Update the canvas size based on content
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
end

local function watchRiftsFolder()
    local rendered = workspace:WaitForChild("Rendered", 5)
    local riftsFolder = rendered and rendered:FindFirstChild("Rifts")
    if not riftsFolder then return end

    riftsFolder.ChildAdded:Connect(refreshEggsAndChests)
    riftsFolder.ChildRemoved:Connect(refreshEggsAndChests)
end

